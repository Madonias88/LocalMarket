# Copia este archivo a .env y ajusta los valores.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/localmarket
# En produccion usa MONGODB_URI de MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/localmarket
# Genera una clave con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-esta-clave-en-produccion
# Credenciales del admin de respaldo (seed crea la cuenta 'admin' en la coleccion users)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-contrasena
# Cuentas owners: el seed crea un usuario por negocio (usuario = slug, password owner123)